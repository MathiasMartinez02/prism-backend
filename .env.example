# Base de datos
DATABASE_URL=postgresql+psycopg://prism:prism@localhost:5432/prism

# Frontend permitido para CORS (lista separada por comas)
CORS_ORIGINS=["http://localhost:3000"]

# GitHub
GITHUB_TOKEN=

# AI provider: gemini | ollama
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Si el backend corre en Docker y Ollama corre en el host (no en un contenedor), usar
# http://host.docker.internal:11434 en vez de localhost - "localhost" adentro del
# contenedor es el contenedor mismo, no tu maquina.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
